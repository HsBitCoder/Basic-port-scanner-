import socket
import threading
import sys
from datetime import datetime

def scan_port(target, port):
    try:
        
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        
        sock.settimeout(1)
      
        result = sock.connect_ex((target, port))
        
        if result == 0:
            print(f"Port {port}: Open")
        sock.close()
    except socket.error as e:
        print(f"Couldn't connect to server: {e}")
    except Exception as e:
        print(f"Error scanning port {port}: {e}")

def scan(target, ports):
    print(f"Scanning target: {target}")
    print(f"Time started: {datetime.now()}")
    
    try:
        
        target_ip = socket.gethostbyname(target)
        print(f"IP address: {target_ip}")
    except socket.gaierror:
        print("Hostname could not be resolved")
        return
    
    
    for port in range(1, ports + 1):
        
        thread = threading.Thread(target=scan_port, args=(target, port))
        thread.start()

if __name__ == "__main__":
   
    target = input("Enter target (hostname or IP): ")
    ports_input = input("Enter number of ports to scan: ")
    
    try:
        ports = int(ports_input)
        if ports <= 0:
            print("Please enter a positive number of ports.")
        else:
            scan(target, ports)
    except ValueError:
        print("Please enter a valid number for ports.")
    
    
    input("Press Enter to exit...")
    
